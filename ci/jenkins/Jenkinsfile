// Jenkins pipeline: build single image -> push to ECR -> redeploy ECS service.
//
// The ECS task definition is managed OUTSIDE this pipeline (you created the
// 'python-td' family in ECS). This pipeline does NOT render or register a task
// definition. It resolves the newest ACTIVE revision of the family, points the
// service at it, and forces a new deployment so ECS re-pulls the image.
//
// IMPORTANT: for the new build to actually run, the task definition's container
// image must point at the ":latest" tag (which this pipeline overwrites on each
// run). If your task def pins a specific SHA/digest, redeploying the same
// revision will not pick up the new image.
//
// Requirements on the Jenkins agent:
//   - docker CLI, aws CLI v2
//   - AWS auth: easiest is an IAM instance profile on the agent. If you instead
//     store credentials in Jenkins, see the commented "withCredentials" block.

pipeline {
    agent any

    environment {
        AWS_REGION      = 'us-east-1'                // <-- change to your region
        ECR_REPOSITORY  = 'python-app'          // <-- your ECR repo name
        ECS_CLUSTER     = 'python-task-cluster'      // <-- your ECS cluster name
        ECS_SERVICE     = 'python-task-service'      // <-- your ECS service name
        ECS_TASK_FAMILY = 'python-td'                // <-- ECS task definition family

        IMAGE_TAG       = "${env.GIT_COMMIT ?: env.BUILD_NUMBER}"

        // Keep the Docker credential file in the workspace so `docker login` and
        // `docker push` share it regardless of the agent user's $HOME. This is
        // the usual fix for "no basic auth credentials" on push.
        DOCKER_CONFIG   = "${env.WORKSPACE}/.docker"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Resolve ECR registry') {
            steps {
                script {
                    env.AWS_ACCOUNT_ID = sh(
                        script: "aws sts get-caller-identity --query Account --output text",
                        returnStdout: true
                    ).trim()
                    env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                    env.IMAGE_URI    = "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"
                    echo "Image: ${env.IMAGE_URI}"
                }
            }
        }

        stage('Build & push image') {
            steps {
                // Login, build, and push in a SINGLE shell so the ECR
                // credentials written by `docker login` are guaranteed present
                // for `docker push` (separate stages/shells can lose them).
                sh '''
                    set -e
                    mkdir -p "$DOCKER_CONFIG"

                    aws ecr get-login-password --region "$AWS_REGION" \
                      | docker login --username AWS --password-stdin "$ECR_REGISTRY"

                    docker build -t "$IMAGE_URI" -t "$ECR_REGISTRY/$ECR_REPOSITORY:latest" .
                    docker push "$IMAGE_URI"
                    docker push "$ECR_REGISTRY/$ECR_REPOSITORY:latest"
                '''
            }
        }

        stage('Deploy to ECS') {
            steps {
                sh '''
                    set -e

                    # Resolve the newest ACTIVE revision of the task family that
                    # you manage in ECS (e.g. python-td:7). No register step.
                    TASK_DEF_ARN=$(aws ecs describe-task-definition \
                      --task-definition "$ECS_TASK_FAMILY" \
                      --region "$AWS_REGION" \
                      --query 'taskDefinition.taskDefinitionArn' --output text)
                    echo "Using task definition: $TASK_DEF_ARN"

                    # Point the service at that revision and force a new
                    # deployment so ECS re-pulls the image.
                    aws ecs update-service \
                      --cluster "$ECS_CLUSTER" \
                      --service "$ECS_SERVICE" \
                      --task-definition "$TASK_DEF_ARN" \
                      --force-new-deployment \
                      --region "$AWS_REGION" > /dev/null

                    # Wait until the deployment stabilizes.
                    aws ecs wait services-stable \
                      --cluster "$ECS_CLUSTER" \
                      --services "$ECS_SERVICE" \
                      --region "$AWS_REGION"
                    echo "Deployment stable"
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout "$ECR_REGISTRY" || true'
            cleanWs()
        }
        success { echo "Deployed ${env.IMAGE_URI} to ${env.ECS_SERVICE}." }
        failure { echo 'Pipeline failed. Check the stage logs above.' }
    }
}

// ── Using Jenkins-stored AWS credentials instead of an instance role ─────────
// If the agent has no IAM instance profile, wrap the AWS stages in:
//
//   withCredentials([usernamePassword(
//       credentialsId: 'aws-deploy-creds',
//       usernameVariable: 'AWS_ACCESS_KEY_ID',
//       passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
//     // sh '...' aws commands here ...
//   }
//
// Create 'aws-deploy-creds' (Username with password) under
// Manage Jenkins > Credentials.
